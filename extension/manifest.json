{
  "manifest_version": 3,
  "name": "Persona Hub Connector",
  "version": "1.0",
  "description": "Securely connects social media accounts to Persona Hub via session cookies.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.pinterest.com/*",
    "*://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"]
    }
  ]
}
